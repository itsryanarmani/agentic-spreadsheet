{
  "name": "agentic-spreadsheet",
  "version": "0.14.3",
  "description": "Spreadsheets with formulas that people and agents edit together.",
  "keywords": [
    "spreadsheet",
    "sheets",
    "formulas",
    "grid",
    "collaboration",
    "agents",
    "mcp",
    "cli",
    "csv",
    "xlsx"
  ],
  "license": "MIT",
  "author": "Pooria Arab",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pooriaarab/agentic-spreadsheet.git"
  },
  "type": "module",
  "private": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "mcpName": "io.github.itsryanarmani/agentic-spreadsheet",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./formats": {
      "types": "./dist/formats.d.ts",
      "import": "./dist/formats.js"
    },
    "./ui": {
      "types": "./dist/embed.d.ts",
      "import": "./dist/embed.js"
    },
    "./ui.css": "./dist/embed.css",
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    },
    "./account": {
      "types": "./dist/account.d.ts",
      "import": "./dist/account.js"
    }
  },
  "bin": {
    "agentic-spreadsheet": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsup && vite build",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p ui",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "ci:local": "npm run build && npm run typecheck && npm test && npm run test:e2e",
    "dev:ui": "WRANGLER_SEND_METRICS=false wrangler dev",
    "test:e2e": "playwright test",
    "deploy:demo": "npm run build && WRANGLER_SEND_METRICS=false wrangler deploy --config wrangler.demo.jsonc",
    "dev": "npm run build && node scripts/dev.mjs",
    "dev:smoke": "node scripts/dev-smoke.mjs"
  },
  "dependencies": {
    "@formulajs/formulajs": "^4.6.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "agentic-design": "^0.10.1",
    "agentic-formats": "^0.4.4",
    "agentic-identity": "^0.12.1",
    "agentic-realtime": "^0.6.1",
    "hono": "^4.13.16",
    "yjs": "^13.6.33",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7",
    "wrangler": "^4.157.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "overrides": {
    "agentic-formats": {
      "zod": "^4.6.7"
    }
  }
}